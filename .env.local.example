# =============================================================================
# Portal Interno EJMC — Variáveis de Ambiente (exemplo)
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha com valores reais antes de
# rodar a aplicação localmente. Nunca faça commit de `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL via Prisma)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/portal_ejmc?schema=public"

# -----------------------------------------------------------------------------
# NextAuth.js v5
# AUTH_SECRET / NEXTAUTH_SECRET: gere com `openssl rand -base64 32`
#   - NextAuth v5 lê `AUTH_SECRET` por padrão; mantemos `NEXTAUTH_SECRET`
#     como alias retrocompatível (ver src/lib/auth.ts).
# NEXTAUTH_URL: URL base da aplicação (em produção, usar a URL pública)
# -----------------------------------------------------------------------------
AUTH_SECRET="gerar-com-openssl-rand-base64-32"
NEXTAUTH_SECRET="gerar-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Google OAuth (login via Google) — Google Cloud Console > Credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# -----------------------------------------------------------------------------
# Resend (envio de emails transacionais — aprovação/rejeição de cadastro etc.)
# Obtenha em https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_sua_api_key_aqui"

# Endereço remetente usado nos emails transacionais. Formato:
#   "Nome de exibição <endereco@dominio.com>"
# Em produção use um domínio verificado na Resend.
EMAIL_FROM="EJMC Portal <no-reply@ejmc.com.br>"

# -----------------------------------------------------------------------------
# Google Calendar (opcional — usado pelo módulo Cronograma, Task 7)
# -----------------------------------------------------------------------------
# ID do calendário compartilhado da EJMC. Se ausente, o módulo opera em
# modo no-op (eventos ficam apenas no banco local — útil para dev/test).
GOOGLE_CALENDAR_ID="primary"

# Credenciais do Service Account (Google Cloud > IAM > Service Accounts).
# O Service Account precisa ser convidado como editor do calendário acima.
# Use UMA das duas formas abaixo:
#   - GOOGLE_SERVICE_ACCOUNT_KEY: JSON inline (recomendado para Vercel).
#   - GOOGLE_SERVICE_ACCOUNT_KEY_FILE: caminho para o arquivo JSON local.
GOOGLE_SERVICE_ACCOUNT_KEY=""
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=""

# -----------------------------------------------------------------------------
# URL base da aplicação usada em links de emails e callbacks
# -----------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Conexão direta para migrações (opcional)
# -----------------------------------------------------------------------------
# Usada só pela Prisma CLI (migrate deploy / migrate dev). Defina quando
# DATABASE_URL apontar para o pooler do Supabase em modo transação (porta
# 6543); aqui vai a conexão direta ou de sessão (porta 5432). Se ficar vazia,
# a CLI usa DATABASE_URL.
DIRECT_URL=""

# -----------------------------------------------------------------------------
# Seed (npx prisma db seed)
# -----------------------------------------------------------------------------
# Senha do administrador criado pelo seed (admin@ejmc.com). OBRIGATÓRIA para
# rodar o seed, mínimo de 8 caracteres; não existe senha padrão no código.
# Prefira definir só na sessão do terminal em vez de gravar em arquivo.
SEED_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Supabase Storage (avatares, fotos do álbum, destaques e propostas em PDF)
# -----------------------------------------------------------------------------
# Usadas SOMENTE no servidor (src/lib/storage.ts). Nunca crie versões com o
# prefixo NEXT_PUBLIC_: a chave de serviço dá acesso total ao Storage e não
# pode chegar ao navegador.
#   - SUPABASE_URL: URL do projeto (Settings > API > Project URL).
#   - SUPABASE_SERVICE_ROLE_KEY: chave de serviço ("service_role" ou
#     "secret key", em Settings > API).
# Sem elas, upload e download de arquivos respondem 503 e o resto do portal
# continua funcionando.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-de-servico"

# Nomes dos buckets (opcional). Ambos devem ser PRIVADOS. Se ficarem vazios,
# valem os padrões abaixo.
SUPABASE_BUCKET_IMAGES="portal-imagens"
SUPABASE_BUCKET_PROPOSALS="portal-propostas"
