# =============================================================================
# Portal Interno EJMC — Variáveis de Ambiente (exemplo)
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha com valores reais antes de
# rodar a aplicação localmente. Nunca faça commit de `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL via Prisma)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/portal_ejmc?schema=public"

# -----------------------------------------------------------------------------
# NextAuth.js v5
# AUTH_SECRET / NEXTAUTH_SECRET: gere com `openssl rand -base64 32`
#   - NextAuth v5 lê `AUTH_SECRET` por padrão; mantemos `NEXTAUTH_SECRET`
#     como alias retrocompatível (ver src/lib/auth.ts).
# NEXTAUTH_URL: URL base da aplicação (em produção, usar a URL pública)
# -----------------------------------------------------------------------------
AUTH_SECRET="gerar-com-openssl-rand-base64-32"
NEXTAUTH_SECRET="gerar-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Google OAuth (login via Google) — Google Cloud Console > Credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# -----------------------------------------------------------------------------
# Resend (envio de emails transacionais — aprovação/rejeição de cadastro etc.)
# Obtenha em https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_sua_api_key_aqui"

# Endereço remetente usado nos emails transacionais. Formato:
#   "Nome de exibição <endereco@dominio.com>"
# Em produção use um domínio verificado na Resend.
EMAIL_FROM="EJMC Portal <no-reply@ejmc.com.br>"

# -----------------------------------------------------------------------------
# Google Calendar (opcional — usado pelo módulo Cronograma)
# ID do calendário compartilhado da EJMC
# -----------------------------------------------------------------------------
GOOGLE_CALENDAR_ID="primary"

# -----------------------------------------------------------------------------
# URL base da aplicação usada em links de emails e callbacks
# -----------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
